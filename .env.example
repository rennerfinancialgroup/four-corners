# ---- Mini-Days Coach config ----
# Copy this file to ".env" and fill in the values.

# Port the server listens on (Render/Railway set this automatically)
PORT=8080

# Your timezone. Check-in times in your plans are interpreted in this zone.
TZ=America/New_York

# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model writes the coach lines.
# Sonnet = best voice. Haiku = cheaper/faster for short pings.
# Model names change over time — verify current strings at https://docs.claude.com
COACH_MODEL=claude-sonnet-4-6

# A long random string that locks down your API so randoms can't burn your
# API credits. You'll paste this same value into the app's Settings once.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=replace-with-a-long-random-string

# Web Push (VAPID) keys. Generate with: npm run gen-vapid
# then paste the printed values here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bobby@rennerfinancialgroup.com
